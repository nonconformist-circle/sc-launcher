##=========================================================================================
## Custom settings independent from the version of sc-launcher.sh
##=========================================================================================

##=========================================================================================
## Hints
##=========================================================================================

## you can use the following envs here:
## any STEAM_* (steam cllient), VK* (Vulkan), DX* (DirectX) or WINE* env variable you want to override or use value from.
## usage:
# export YOUR_ENV_NAME=value

##=========================================================================================
## Some usefull settings as template
##=========================================================================================

## The default laucher exe name inside Proton prefix. If you have changed it there, so do it here
# RSI_LAUNCHER="RSI Launcher.exe"

## By default the Proton prefix will be located in steams compatibility path like ~/.steam/debian-installation/steamapps/compatdata/<STEAM_CLIENT_APP_ID>
## For better game performance you can use a different path (e.g. on separate nvme). 
## Place the sc-launcher.sh on a faster disk, e.g. /mnt/games/starcitizen and change STEAM_COMPAT_DATA_PATH=${wdir} (same dir as the sc-launcher.sh)
## Steam will place a pfx under ~/.steam/debian-installation/steamapps/compatdata/<STEAM_CLIENT_APP_ID>/pfx anyway that cost you ~700MB as long you have a storage /home, but one can delete it.
# [ ! -z "${STEAM_COMPAT_DATA_PATH}" ] && [ -d ${STEAM_COMPAT_DATA_PATH}/pfx ] && rm -rf ${STEAM_COMPAT_DATA_PATH}/pfx*
# STEAM_COMPAT_DATA_PATH=${wdir} 
## or put the prefix wherever you want:

## If you want to bind Star Citizen to a specific Proton build rather than switch it via Steam client GUI, use:
# PROTON_FLAVOR=/absolute/path/to/Proton-runner-dir

##=========================================================================================
## prefix patches
##=========================================================================================
## Optional workaround for SC 4.7 MSVCP140/vcrun issue under Proton
## add apply_vcrun2022_workaround to APPLY_PATHCES

## Optional fix mouse behavior
# add apply_mouse_coordinate_fix to APPLY_PATHCES

#APPLY_PATHCES="${APPLY_PATHCES} apply_vcrun2022_workaround apply_mouse_coordinate_fix"

##=========================================================================================
## Vulkan / DX setup
##=========================================================================================

## by default the game settings files will be patched to run the desired api DX/Vulkan. You can switch this feature off.
# PATCH_GAME_SETUP_GRAPHICS_API=false

## Disable Vulkan api usage (defalt is enabled) in favor of DirectX api
# USE_VULKAN=false

## On troubles with Vulkan in a multi GPU environment, potential help could be to disable automatic device detection
# export DISABLE_MESA_VK_DEVICE_SELECT=1


##=========================================================================================
## The Wine HUD is for debugging. 
##=========================================================================================

## While playing, it’s much better to use the Steam Overlay Performance Monitor,
## Open steam client, in the upper left menu: Steam → Settings → In Game → Overlay Performance Monitor.
# export DXVK_HUD=0 # Options (comma separated list): api, fps, frametime, devinfo, gpuload, version
# export DXVK_HUD_FONT_SCALE=0.5
# export DXVK_HUD_POSITION=top-left # Options: top-left (default), top-right, bottom-left, bottom-right

##=========================================================================================
## Logging for debugging
##=========================================================================================

## DXVK extra logs for GPU related operations
# export DXVK_LOG_LEVEL=debug
# export WINEDEBUG=err+all,+seh,+unwind,+vulkan
## VK_LOADER_DEBUG can be noisy; "warn" is usually enough.
# export VK_LOADER_DEBUG=${VK_LOADER_DEBUG:-warn}

## Proton main log
# export PROTON_LOG=1

## By default all output goes via steam to system logging and is accessable via journalctl -u steam.
## if you want to log to separate file, use:
# CUSTOM_LOG_FILE=${wdir}/sc-launcher.log

## You can dump the entire steam environment on running the script using 
# DUMP_STEAM_EVNIRONMENT=true

